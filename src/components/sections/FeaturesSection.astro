---
import SectionHeading from '../SectionHeading.astro';

const NUMBER_DIGITS = 2;
const FEATURES = [
  {
    title: 'スタッフごとに予約ページを作る',
    body: 'スタッフを招待し、一人ずつ予約ページを作れます。ページの URL を SNS のプロフィールや店のサイトに載せれば、お客様は指名したいスタッフのページから予約できます。',
  },
  {
    title: 'スタッフの空き時間だけを枠にする',
    body: 'スタッフの Google カレンダーを読み取り、予定が入っていない時間だけを予約枠として表示します。休みや私用の予定を入れれば、その時間は予約ページに出ません。',
  },
  {
    title: '店の予約をまとめて管理する',
    body: '予約ページから入った予約は、どのスタッフのページから入ったかとあわせて管理画面の一覧に並びます。予約を把握するために、スタッフに一件ずつ確かめる必要はありません。',
  },
  {
    title: 'お客様はアカウントなしで予約できる',
    body: 'お客様は名前とメールアドレスを入れ、届いたメールのリンクを開けば予約が確定します。キャンセルも確定後に届くメールから手続きできます。',
  },
  {
    title: '予約時に聞きたいことを聞く',
    body: 'ご要望や連絡先など、予約時に聞きたい項目を追加できます。テキスト、電話番号、選択肢、チェックボックスなどに対応し、回答は予約の内容と一緒に確認できます。',
  },
  {
    title: '受付時間と枠の長さを決める',
    body: '受付を始める時刻と終える時刻、1 枠の長さを予約ページごとに設定できます。予約を受けたくない時間帯も除外できます。',
  },
];
---
<section class="features">
  <div class="inner">
    <SectionHeading
      id="features"
      time="12:00"
      eyebrow="Features"
      title="主な機能"
      lead="スタッフの予約ページづくりから、予約の受付、店での管理まで。指名の予約を受けるのに必要なことを一つにまとめています。"
    />
    <ul class="cards">
      {FEATURES.map((feature, index) => (
        <li class="card">
          <span class="number" aria-hidden="true">{String(index + 1).padStart(NUMBER_DIGITS, '0')}</span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features {
    padding: 120px 32px 112px;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }
  .cards {
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    padding: 30px 28px 32px;
    border-radius: 24px;
    background: var(--color-surface);
  }
  .number {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 40px;
    line-height: 1;
    color: var(--color-accent);
  }
  h3 {
    margin: 18px 0 10px;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.6;
  }
  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.95;
    color: var(--color-text-sub);
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .features {
      padding: 88px 16px;
    }
    .cards {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 40px;
      gap: 12px;
    }
    .card {
      padding: 24px 20px;
    }
  }
</style>
