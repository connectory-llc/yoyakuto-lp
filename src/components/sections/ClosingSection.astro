---
import CtaButtons from '../CtaButtons.astro';
import SectionHeading from '../SectionHeading.astro';
---
<section class="closing">
  <div class="inner">
    <SectionHeading
      id="get-started"
      time="16:00"
      eyebrow="Get started"
      title="指名の予約を DM から予約ページへ"
      lead="Google アカウントがあれば、今日からスタッフの予約ページを公開できます。"
    />
    <CtaButtons secondaryHref="#flow" secondaryLabel="使い方を見る" />
  </div>
</section>

<style>
  .closing {
    padding: 0 32px 112px;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 64px 56px;
    border-radius: 32px;
    background: var(--color-sky);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 40px;
  }
  @media (max-width: 760px) {
    .closing {
      padding: 0 16px 80px;
    }
    .inner {
      padding: 40px 22px;
    }
  }
</style>
