---
import SectionHeading from '../SectionHeading.astro';

const BEFORE = [
  'お客様からスタッフの DM に予約の相談が届く',
  '施術の合間に空いている日時を返す',
  '日時が決まるまでやり取りを続ける',
  '決まった予約をスタッフが店に伝える',
];
const AFTER = ['お客様が指名したいスタッフの予約ページを開く', '空いている枠を選んで予約する', '予約が店の管理画面とカレンダーに入る'];
---
<section class="highlight">
  <div class="inner">
    <SectionHeading
      id="before-after"
      time="10:30"
      eyebrow="Why Yoyakuto"
      title="予約の受付を DM から外す"
      lead="DM に返信して、空いている日時を伝えて、決まった予約を店に知らせる。その手順を予約ページに任せられます。"
      tone="ink"
    />
    <div class="compare">
      <div class="column before">
        <p class="column-title">これまで</p>
        <ol>
          {BEFORE.map((step) => <li>{step}</li>)}
        </ol>
      </div>
      <div class="column after">
        <p class="column-title">Yoyakuto なら</p>
        <ol>
          {AFTER.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .highlight {
    padding: 112px 32px;
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }
  .compare {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .column {
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--color-ink-line);
  }
  .after {
    border-color: var(--color-free-on-ink);
    background: var(--color-free-on-ink-soft);
  }
  .column-title {
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--color-ink-sub);
  }
  .after .column-title {
    color: var(--color-free-on-ink);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  li {
    counter-increment: step;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
  }
  li::before {
    content: counter(step);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--color-ink-line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-sub);
  }
  .before li {
    color: var(--color-ink-sub);
  }
  .after li::before {
    border-color: var(--color-free-on-ink);
    background: var(--color-free-on-ink);
    color: var(--color-ink);
  }
  @media (max-width: 760px) {
    .highlight {
      padding: 88px 16px;
    }
    .compare {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 36px;
    }
    .column {
      padding: 22px 18px;
    }
    li {
      font-size: 14px;
    }
  }
</style>
