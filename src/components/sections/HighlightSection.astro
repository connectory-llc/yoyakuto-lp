---
import { freeSlotsOf, NOMINATED, pageName, sampleDateLabel, slotAt, slotLabel } from '../../sampleSchedule';
import SectionHeading from '../SectionHeading.astro';

// 見本の DM。from が customer ならお客様、staff ならスタッフの発言。スタッフが空いていると答える時刻は、見本の予定の空き枠に合わせる
const FREE_SLOTS = freeSlotsOf(NOMINATED);
const DESIRED_FROM_HOUR = 16;
const DESIRED_FROM_SLOT = slotAt(DESIRED_FROM_HOUR);
const PICKED_SLOT = FREE_SLOTS.find((slot) => slot >= DESIRED_FROM_SLOT);
if (PICKED_SLOT === undefined) {
  throw new Error(`見本の予定で ${DESIRED_FROM_HOUR} 時以降に空いている枠がないため、DM との違いの図を描けません`);
}
const AFTERNOON_START_HOUR = 13;
const OFFERED_SLOT = FREE_SLOTS.find((slot) => slot >= slotAt(AFTERNOON_START_HOUR) && slot < DESIRED_FROM_SLOT);
if (OFFERED_SLOT === undefined) {
  throw new Error(`見本の予定で ${AFTERNOON_START_HOUR} 時から ${DESIRED_FROM_HOUR} 時の間に空いている枠がないため、DM との違いの図を描けません`);
}
const MESSAGES = [
  { from: 'customer', text: '来週の土曜の午後って空いてますか？', meta: 'お客様　23:48' },
  { from: 'staff', text: `${slotLabel(OFFERED_SLOT)} なら空いてます`, meta: 'スタッフ　翌日 12:10' },
  { from: 'customer', text: `その時間は難しくて… ${DESIRED_FROM_HOUR} 時以降はどうですか？`, meta: 'お客様　12:52' },
  { from: 'staff', text: '確認して、また連絡しますね', meta: 'スタッフ　18:30' },
];
const AFTER = ['お客様が指名したいスタッフの予約ページを開く', '空いている枠を選んで予約する', '予約が店の管理画面とカレンダーに入る'];
---
<section class="highlight">
  <div class="inner">
    <SectionHeading
      id="before-after"
      time="10:00"
      eyebrow="Before / After"
      title="予約の受付を DM から外す"
      lead="DM に返信して、空いている日時を伝えて、決まった予約を店に知らせる。その手順を予約ページに任せられます。"
    />
    <div class="compare">
      <div class="column before">
        <p class="column-title">これまで　スタッフの DM で受ける</p>
        <ul class="thread">
          {MESSAGES.map((message) => (
            <li class:list={['message', message.from]}>
              <span class="bubble">{message.text}</span>
              <span class="meta">{message.meta}</span>
            </li>
          ))}
        </ul>
        <p class="note">日時が決まるまで、施術の合間にやり取りが続く。決まった予約を、店はまだ知らない。</p>
      </div>
      <div class="column after">
        <p class="column-title">Yoyakuto なら　スタッフの予約ページで受ける</p>
        <div class="page" aria-hidden="true">
          <p class="page-head">
            <span class="avatar" style={`background: var(--color-avatar-${NOMINATED.avatar}); color: var(--color-avatar-${NOMINATED.avatar}-ink)`}>{NOMINATED.initial}</span>
            <span class="page-name">{pageName(NOMINATED)}</span>
            <span class="page-date" lang="en">{sampleDateLabel()}</span>
          </p>
          <ul class="slots">
            {FREE_SLOTS.map((slot) => <li class:list={{ picked: slot === PICKED_SLOT }}>{slotLabel(slot)}</li>)}
          </ul>
        </div>
        <ol class="steps">
          {AFTER.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .highlight {
    padding: 112px 32px;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }
  .compare {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .column {
    padding: 32px;
    border-radius: 28px;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .column-title {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text-sub);
  }
  .after .column-title {
    color: var(--color-accent);
  }
  .thread {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .message {
    max-width: 82%;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .customer {
    align-self: flex-start;
  }
  .staff {
    align-self: flex-end;
    align-items: flex-end;
  }
  .bubble {
    padding: 10px 16px;
    font-size: 14px;
    line-height: 1.7;
  }
  .customer .bubble {
    border-radius: 18px 18px 18px 4px;
    background: var(--color-bg);
  }
  .staff .bubble {
    border-radius: 18px 18px 4px 18px;
    background: var(--color-busy);
  }
  .meta {
    font-size: 11px;
    color: var(--color-text-sub);
  }
  .note {
    margin: 0;
    padding-top: 16px;
    border-top: 1px dashed var(--color-border);
    font-size: 14px;
    line-height: 1.9;
    color: var(--color-text-sub);
  }
  .page {
    padding: 20px;
    border-radius: 20px;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .page-head {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
  }
  .page-name {
    font-size: 14px;
    font-weight: 700;
  }
  .page-date {
    margin-left: auto;
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 18px;
    color: var(--color-accent);
  }
  .slots {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .slots li {
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--color-sky);
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 19px;
    line-height: 1.4;
    color: var(--color-free);
  }
  .slots .picked {
    background: var(--color-free);
    color: #ffffff;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .steps li {
    counter-increment: step;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 15px;
  }
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    flex-shrink: 0;
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 20px;
    color: var(--color-accent);
  }
  @media (max-width: 760px) {
    .highlight {
      padding: 80px 16px;
    }
    .compare {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 36px;
    }
    .column {
      padding: 24px 18px;
    }
    .steps li {
      font-size: 14px;
    }
  }
</style>
