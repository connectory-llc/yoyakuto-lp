---
import CtaButtons from '../CtaButtons.astro';

const DAY_START_HOUR = 10;
const SLOT_MINUTES = 30;
const SLOT_COUNT = 18;
const MINUTES_PER_HOUR = 60;
const TWO_DIGITS = 2;

// 見本の予定。start と end は 10:00 から数えた 30 分枠の位置で、end の枠は含まない
const STAFF = [
  { name: 'ミカ', initial: 'ミ', tint: 'var(--color-avatar-1)', ink: 'var(--color-avatar-1-ink)', busy: [{ start: 0, end: 3 }, { start: 5, end: 9 }, { start: 12, end: 14 }, { start: 15, end: 18 }] },
  { name: 'ユウト', initial: 'ユ', tint: 'var(--color-avatar-2)', ink: 'var(--color-avatar-2-ink)', busy: [{ start: 1, end: 4 }, { start: 6, end: 8 }, { start: 10, end: 13 }, { start: 14, end: 17 }] },
  { name: 'サキ', initial: 'サ', tint: 'var(--color-avatar-3)', ink: 'var(--color-avatar-3-ink)', busy: [{ start: 0, end: 2 }, { start: 3, end: 6 }, { start: 8, end: 11 }, { start: 13, end: 15 }, { start: 16, end: 18 }] },
];
const NOMINATED_INDEX = 2;

const slotLabel = (slot: number) => {
  const minutes = DAY_START_HOUR * MINUTES_PER_HOUR + slot * SLOT_MINUTES;
  const hour = Math.floor(minutes / MINUTES_PER_HOUR);
  const minute = String(minutes % MINUTES_PER_HOUR).padStart(TWO_DIGITS, '0');
  return `${hour}:${minute}`;
};

const nominated = STAFF[NOMINATED_INDEX];
const nominatedFreeSlots = Array.from({ length: SLOT_COUNT }, (_, slot) => slot).filter(
  (slot) => !nominated.busy.some((range) => range.start <= slot && slot < range.end),
);
const gridColumn = (start: number, end: number) => `${start + 1} / ${end + 1}`;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="inner">
    <div class="copy">
      <p class="tagline" lang="en">Reservations for the person you choose</p>
      <h1 id="hero-title"><span>その予約</span> <span>まだ DM で受けていますか</span></h1>
      <div class="lead-row">
        <span class="rule" aria-hidden="true"></span>
        <p class="lead">
          担当を指名して予約できる予約受付サービスです。スタッフ一人ひとりに予約ページを用意でき、入った予約は管理画面と Google カレンダーにまとめて届きます。日時を決めるための DM のやり取りは要りません。
        </p>
      </div>
      <CtaButtons secondaryHref="#before-after" secondaryLabel="DM との違いを見る" />
    </div>

    <figure class="board">
      <div class="card" aria-hidden="true">
        <p class="card-head">
          <span class="card-title">スタッフの予定</span>
          <span class="card-date" lang="en">Sat. 22 Nov</span>
        </p>
        <div class="rows">
          {STAFF.map((staff, index) => (
            <div class:list={['row', { nominated: index === NOMINATED_INDEX }]}>
              <span class="name">
                <span class="avatar" style={`background: ${staff.tint}; color: ${staff.ink}`}>{staff.initial}</span>
                {staff.name}
              </span>
              <span class="track" style={`--slots: ${SLOT_COUNT}`}>
                {staff.busy.map((range) => (
                  <span class="block" style={`grid-column: ${gridColumn(range.start, range.end)}`}></span>
                ))}
                {index === NOMINATED_INDEX &&
                  nominatedFreeSlots.map((slot) => (
                    <span class="free" style={`grid-column: ${gridColumn(slot, slot + 1)}`}></span>
                  ))}
              </span>
            </div>
          ))}
        </div>
        <p class="page-label">{nominated.name}さんの予約ページ</p>
        <ul class="chips">
          {nominatedFreeSlots.map((slot) => <li>{slotLabel(slot)}</li>)}
        </ul>
      </div>
      <figcaption>
        予約ページに並ぶのは、指名されたスタッフの予定が空いている時間だけです。この見本では{nominated.name}さんの {nominatedFreeSlots.length} 枠が並びます。
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .inner {
    max-width: 1248px;
    margin: 0 auto;
    padding: 64px 32px 96px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: 64px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .tagline {
    margin: 0;
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 22px;
    letter-spacing: 0.02em;
    color: var(--color-free);
  }
  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(32px, 3.4vw, 48px);
    line-height: 1.45;
    letter-spacing: 0.03em;
  }
  h1 span {
    display: block;
  }
  .lead-row {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }
  .rule {
    flex: none;
    width: 48px;
    height: 1px;
    margin-top: 16px;
    background: var(--color-free);
  }
  .lead {
    margin: 0;
    max-width: 480px;
    font-size: 15px;
    line-height: 2.1;
    color: var(--color-text-sub);
  }
  .copy :global(.cta) {
    margin-left: 80px;
  }

  .board {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card {
    padding: 32px 28px;
    border-radius: 28px;
    background: var(--color-surface);
    box-shadow: 0 30px 60px -44px var(--shadow-color);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card-head {
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .card-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
  }
  .card-date {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 20px;
    color: var(--color-free);
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border-radius: 18px;
    background: var(--color-bg);
  }
  .row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-sub);
    white-space: nowrap;
  }
  .nominated .name {
    font-weight: 700;
    color: var(--color-text);
  }
  .avatar {
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 500;
  }
  .track {
    display: grid;
    grid-template-columns: repeat(var(--slots), minmax(0, 1fr));
    height: 20px;
  }
  .block,
  .free {
    grid-row: 1;
    margin: 3px 1px;
    border-radius: 4px;
  }
  .block {
    background: var(--color-busy);
  }
  .free {
    background: var(--color-free);
  }
  .page-label {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-free);
  }
  .chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--color-sky);
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 20px;
    line-height: 1.4;
    color: var(--color-free);
  }
  figcaption {
    font-size: 12px;
    color: var(--color-text-sub);
    text-align: center;
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      padding: 40px 16px 80px;
      gap: 48px;
    }
    h1 {
      font-size: 40px;
    }
    .lead-row {
      gap: 20px;
    }
    .rule {
      width: 28px;
    }
    .copy :global(.cta) {
      margin-left: 0;
    }
  }
  @media (max-width: 480px) {
    h1 {
      font-size: 28px;
    }
    .lead-row {
      display: block;
    }
    .rule {
      display: none;
    }
    .card {
      padding: 22px 16px;
    }
    .rows {
      padding: 14px 12px;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
