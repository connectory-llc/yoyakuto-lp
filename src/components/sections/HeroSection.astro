---
import CtaButtons from '../CtaButtons.astro';

const DAY_START_HOUR = 10;
const SLOT_MINUTES = 30;
const SLOT_COUNT = 18;
const AXIS_EVERY_SLOTS = 6;
const MINUTES_PER_HOUR = 60;
const TWO_DIGITS = 2;

// 見本の予定。start と end は 10:00 から数えた 30 分枠の位置で、end の枠は含まない
const STAFF = [
  { name: 'ミカ', color: 'var(--color-member-1)', busy: [{ start: 0, end: 3 }, { start: 5, end: 9 }, { start: 12, end: 14 }, { start: 15, end: 18 }] },
  { name: 'ユウト', color: 'var(--color-member-2)', busy: [{ start: 1, end: 4 }, { start: 6, end: 8 }, { start: 10, end: 13 }, { start: 14, end: 17 }] },
  { name: 'サキ', color: 'var(--color-member-3)', busy: [{ start: 0, end: 2 }, { start: 3, end: 6 }, { start: 8, end: 11 }, { start: 13, end: 15 }, { start: 16, end: 18 }] },
];
const NOMINATED_INDEX = 2;

const slotLabel = (slot: number) => {
  const minutes = DAY_START_HOUR * MINUTES_PER_HOUR + slot * SLOT_MINUTES;
  const hour = Math.floor(minutes / MINUTES_PER_HOUR);
  const minute = String(minutes % MINUTES_PER_HOUR).padStart(TWO_DIGITS, '0');
  return `${hour}:${minute}`;
};

const nominated = STAFF[NOMINATED_INDEX];
const nominatedFreeSlots = Array.from({ length: SLOT_COUNT }, (_, slot) => slot).filter(
  (slot) => !nominated.busy.some((range) => range.start <= slot && slot < range.end),
);
const axis = Array.from({ length: SLOT_COUNT / AXIS_EVERY_SLOTS + 1 }, (_, index) => index * AXIS_EVERY_SLOTS);
const gridColumn = (start: number, end: number) => `${start + 1} / ${end + 1}`;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="inner">
    <div class="copy">
      <p class="tag">スタッフ指名の予約受付サービス</p>
      <h1 id="hero-title"><span>その予約</span> <span>まだ DM で受けていますか</span></h1>
      <p class="lead">
        スタッフ一人ひとりに、指名の予約を受ける予約ページを用意できます。お客様は空いている枠を選んで予約し、入った予約は店の管理画面と Google カレンダーにまとめて届きます。日時を決めるための DM のやり取りは要りません。
      </p>
      <CtaButtons />
    </div>

    <figure class="board">
      <div class="card" aria-hidden="true">
        <div class="card-head">
          <span class="card-title">スタッフの予定</span>
          <span class="card-date">11/21 土</span>
        </div>
        <div class="rows">
          {STAFF.map((staff, index) => (
            <div class:list={['row', { nominated: index === NOMINATED_INDEX }]}>
              <span class="name">
                <span class="swatch" style={`background: ${staff.color}`}></span>
                {staff.name}
                {index === NOMINATED_INDEX && <span class="badge">指名</span>}
              </span>
              <span class="track" style={`--slots: ${SLOT_COUNT}`}>
                {staff.busy.map((range) => (
                  <span class="block" style={`grid-column: ${gridColumn(range.start, range.end)}; --block-color: ${staff.color}`}></span>
                ))}
                {index === NOMINATED_INDEX &&
                  nominatedFreeSlots.map((slot) => (
                    <span class="free" style={`grid-column: ${gridColumn(slot, slot + 1)}`}></span>
                  ))}
              </span>
            </div>
          ))}
          <div class="row axis-row">
            <span class="name"></span>
            <span class="axis">
              {axis.map((slot) => (
                <span style={`left: ${(slot / SLOT_COUNT) * 100}%`}>{slotLabel(slot)}</span>
              ))}
            </span>
          </div>
        </div>
        <div class="page">
          <p class="page-label">{nominated.name}さんの予約ページ</p>
          <ul class="chips">
            {nominatedFreeSlots.map((slot) => <li>{slotLabel(slot)}</li>)}
          </ul>
        </div>
      </div>
      <figcaption>
        予約ページに並ぶのは、指名されたスタッフの予定が空いている時間だけです。この見本では{nominated.name}さんの {nominatedFreeSlots.length} 枠が並びます。
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    background:
      linear-gradient(var(--color-grid) 1px, transparent 1px) 0 0 / 100% 48px,
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px) 0 0 / 96px 100%,
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 96px 32px 104px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .tag {
    margin: 0;
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 13px;
    color: var(--color-text-sub);
  }
  h1 {
    margin: 0;
    font-weight: 700;
    font-size: 44px;
    line-height: 1.45;
    letter-spacing: 0.01em;
  }
  h1 span {
    display: inline-block;
  }
  .lead {
    margin: 0;
    max-width: 520px;
    font-size: 16px;
    line-height: 2;
    color: var(--color-text-sub);
  }
  .copy :global(.cta) {
    margin-top: 8px;
  }

  .board {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: 0 30px 60px -36px var(--shadow-color);
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .card-title {
    font-weight: 700;
    font-size: 16px;
  }
  .card-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-sub);
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 0 6px;
  }
  .row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-sub);
    white-space: nowrap;
  }
  .badge {
    padding: 0 8px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-size: 11px;
    line-height: 20px;
  }
  .nominated {
    margin: 0 -10px;
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--color-bg);
  }
  .nominated .name {
    font-weight: 700;
    color: var(--color-text);
  }
  .swatch {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .track {
    display: grid;
    grid-template-columns: repeat(var(--slots), minmax(0, 1fr));
    height: 26px;
    border-radius: 6px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-bg) 0 calc(100% / var(--slots) - 1px),
      var(--color-grid) calc(100% / var(--slots) - 1px) calc(100% / var(--slots))
    );
  }
  .block {
    grid-row: 1;
    margin: 3px 1px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--block-color) 22%, white);
    border-left: 3px solid var(--block-color);
  }
  .free {
    grid-row: 1;
    margin: 3px 1px;
    border-radius: 4px;
    background: var(--color-free);
  }
  .axis {
    position: relative;
    height: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-sub);
  }
  .axis span {
    position: absolute;
    transform: translateX(-50%);
  }
  .axis span:first-child {
    transform: none;
  }
  .axis span:last-child {
    transform: translateX(-100%);
  }
  .page {
    margin-top: 14px;
    padding: 16px;
    border-radius: 10px;
    background: var(--color-free-soft);
  }
  .page-label {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-free);
  }
  .chips {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 6px 14px;
    border: 1px solid var(--color-free);
    border-radius: 6px;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-free);
  }
  figcaption {
    font-size: 12px;
    color: var(--color-text-sub);
    text-align: center;
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      padding: 64px 16px 80px;
      gap: 48px;
    }
    h1 {
      font-size: 38px;
    }
  }
  @media (max-width: 480px) {
    h1 {
      font-size: 28px;
    }
    .lead {
      font-size: 15px;
    }
    .card {
      padding: 18px 14px;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .axis-row .name {
      display: none;
    }
  }
</style>
