---
interface Props {
  id: string;
  time: string;
  eyebrow: string;
  title: string;
  lead?: string;
  tone?: 'default' | 'ink';
}

const { id, time, eyebrow, title, lead, tone = 'default' } = Astro.props;
---
<div class:list={['section-heading', tone]}>
  <p class="label">
    <span class="time">{time}</span>
    <span class="eyebrow">{eyebrow}</span>
  </p>
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 680px;
  }
  .label {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 14px;
    color: var(--color-text-sub);
  }
  .time {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 22px;
    line-height: 1;
    color: var(--color-free);
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 36px;
    line-height: 1.5;
    letter-spacing: 0.03em;
  }
  .lead {
    margin: 0;
    font-size: 15px;
    line-height: 2.1;
    color: var(--color-text-sub);
  }
  .ink .label,
  .ink .lead {
    color: var(--color-ink-sub);
  }
  .ink .time {
    color: var(--color-free-on-ink);
  }
  @media (max-width: 760px) {
    h2 {
      font-size: 27px;
    }
    .lead {
      font-size: 14px;
    }
  }
</style>
